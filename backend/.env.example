# Copy to .env and adjust as needed.
# JSON list of origins allowed to call the API from a browser (the Vite dev server by default).
CORS_ORIGINS=["http://localhost:5173"]

# Postgres from compose.yaml. The +asyncpg part picks the async driver SQLAlchemy uses.
DATABASE_URL=postgresql+asyncpg://aiplayground:aiplayground@localhost:5432/aiplayground

# Optional. Without a key the app uses FakeLLM. Create one at platform.claude.com.
# ANTHROPIC_API_KEY=sk-ant-...
# Optional. Defaults to claude-opus-5-5; claude-haiku-5-5 is much cheaper for experimenting.
# ANTHROPIC_MODEL=claude-haiku-5-5
